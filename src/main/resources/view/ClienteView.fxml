<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0" styleClass="conteudo" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ClienteViewController">
   <children>
      <!-- Cabeçalho da Página -->
      <VBox spacing="4.0">
         <children>
            <Label styleClass="titulo-pagina" text="Clientes" />
            <Label styleClass="subtitulo-pagina" text="Quem contrata os transportes" />
         </children>
      </VBox>

      <!-- Layout de Duas Colunas -->
      <HBox spacing="18.0" VBox.vgrow="ALWAYS">
         <children>
            <!-- COLUNA ESQUERDA: LISTA DE CLIENTES -->
            <VBox spacing="14.0" styleClass="card" HBox.hgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER_LEFT">
                     <children>
                        <Label styleClass="card-titulo" text="Lista de clientes" />
                        <Pane HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#limpar" styleClass="btn-primario" text="+ Novo" />
                     </children>
                  </HBox>

                  <TableView fx:id="tabela" onKeyPressed="#deletarItem" onMouseClicked="#selecionarItem" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="colNome" prefWidth="240.0" text="Nome" />
                        <TableColumn fx:id="colContacto" prefWidth="160.0" text="Contacto" />
                        <TableColumn fx:id="colLocalizacao" prefWidth="200.0" text="Localização" />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>

                  <!-- Paginação -->
                  <HBox alignment="CENTER_LEFT" spacing="12.0">
                     <children>
                        <Label styleClass="texto-suave, texto-pequeno" text="Mostrar 10 · Total 24" />
                        <Pane HBox.hgrow="ALWAYS" />
                        <HBox spacing="6.0">
                           <children>
                              <Button styleClass="btn-primario" style="-fx-min-width: 32px; -fx-min-height: 32px; -fx-padding: 0;" text="1" />
                              <Button styleClass="btn-secundario" style="-fx-min-width: 32px; -fx-min-height: 32px; -fx-padding: 0;" text="2" />
                              <Button styleClass="btn-secundario" style="-fx-min-width: 32px; -fx-min-height: 32px; -fx-padding: 0;" text="3" />
                           </children>
                        </HBox>
                     </children>
                  </HBox>
               </children>
            </VBox>

            <!-- COLUNA DIREITA: FORMULÁRIO DADOS DO CLIENTE -->
            <VBox maxWidth="420.0" minWidth="340.0" prefWidth="380.0" spacing="16.0" styleClass="card">
               <children>
                  <Label styleClass="card-titulo" text="Dados do cliente" />

                  <VBox spacing="6.0">
                     <children>
                        <Label styleClass="form-label" text="Nome" />
                        <TextField fx:id="txtNome" promptText="Ex.: Agro Beira" />
                     </children>
                  </VBox>

                  <VBox spacing="6.0">
                     <children>
                        <Label styleClass="form-label" text="Contacto" />
                        <TextField fx:id="txtContacto" promptText="Ex.: 84 111 0001" />
                     </children>
                  </VBox>

                  <VBox spacing="6.0">
                     <children>
                        <Label styleClass="form-label" text="Localização" />
                        <TextField fx:id="txtLocalizacao" promptText="Ex.: Beira / Bairro Central" />
                     </children>
                  </VBox>

                  <Label fx:id="lblMensagem" styleClass="mensagem-erro" wrapText="true" />

                  <Pane VBox.vgrow="ALWAYS" />

                  <!-- Ações -->
                  <VBox spacing="10.0">
                     <children>
                        <HBox spacing="10.0">
                           <children>
                              <Button fx:id="btnGuardar" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#guardar" styleClass="btn-primario" text="⤓ Guardar" HBox.hgrow="ALWAYS" />
                              <Button fx:id="btnActualizar" disable="true" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#actualizar" styleClass="btn-secundario" text="Actualizar" HBox.hgrow="ALWAYS" />
                           </children>
                        </HBox>
                        <HBox spacing="10.0">
                           <children>
                              <Button fx:id="btnLimpar" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#limpar" styleClass="btn-secundario" text="Limpar" HBox.hgrow="ALWAYS" />
                              <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#limpar" styleClass="btn-perigo" text="Eliminar" HBox.hgrow="ALWAYS" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</VBox>
