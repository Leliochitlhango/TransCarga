<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0" styleClass="conteudo" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.VeiculoViewController">
   <children>
      <!-- Cabeçalho da Página -->
      <VBox spacing="4.0">
         <children>
            <Label styleClass="titulo-pagina" text="Veículos" />
            <Label styleClass="subtitulo-pagina" text="Gestão da frota: Transporte de Mercadorias e Passageiros" />
         </children>
      </VBox>

      <!-- Barra de Filtros Segmentados -->
      <HBox alignment="CENTER_LEFT" spacing="12.0">
         <children>
            <HBox spacing="4.0" styleClass="segmentos">
               <children>
                  <Button fx:id="btnFiltroTodos" mnemonicParsing="false" onAction="#filtrarTodos" styleClass="segmento, segmento-activo" text="Todos" />
                  <Button fx:id="btnFiltroMercadoria" mnemonicParsing="false" onAction="#filtrarMercadoria" styleClass="segmento" text="Mercadoria (Camiões)" />
                  <Button fx:id="btnFiltroPassageiros" mnemonicParsing="false" onAction="#filtrarPassageiros" styleClass="segmento" text="Passageiros (Carrinhas)" />
               </children>
            </HBox>
            <Pane HBox.hgrow="ALWAYS" />
            <Label fx:id="lblTotalFrota" styleClass="texto-suave, texto-pequeno" text="Ordenado por capacidade ▲ crescente" />
         </children>
      </HBox>

      <!-- Layout de Duas Colunas (Tabela à esquerda, Formulário à direita) -->
      <HBox spacing="18.0" VBox.vgrow="ALWAYS">
         <children>
            <!-- COLUNA ESQUERDA: LISTA DA FROTA -->
            <VBox spacing="14.0" styleClass="card" HBox.hgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER_LEFT">
                     <children>
                        <Label styleClass="card-titulo" text="Frota Activa" />
                        <Pane HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#limpar" styleClass="btn-primario" text="Novo" />
                     </children>
                  </HBox>

                  <TableView fx:id="tabela" onMouseClicked="#selecionarItem" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="colMatricula" prefWidth="120.0" text="Matrícula" />
                        <TableColumn fx:id="colTipo" prefWidth="130.0" text="Aplicação" />
                        <TableColumn fx:id="colMarca" prefWidth="120.0" text="Doc. Identificação" />
                        <TableColumn fx:id="colModelo" prefWidth="140.0" text="Detalhe / Carga" />
                        <TableColumn fx:id="colCapacidade" prefWidth="130.0" text="Capacidade / Lotação ▲" />
                        <TableColumn fx:id="colProprietario" prefWidth="160.0" text="Proprietário" />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>

                  <!-- Total -->
                  <HBox alignment="CENTER_LEFT" spacing="12.0">
                     <children>
                        <Label fx:id="lblResumoTabela" styleClass="texto-suave, texto-pequeno" text="Total de veículos" />
                     </children>
                  </HBox>
               </children>
            </VBox>

            <!-- COLUNA DIREITA: FORMULÁRIO DADOS DO VEÍCULO -->
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" maxWidth="430.0" minWidth="340.0" prefWidth="380.0" styleClass="scroll-transparente">
               <content>
                  <VBox spacing="14.0" styleClass="card">
                     <children>
                        <Label styleClass="card-titulo" text="Dados do veículo" />

                        <!-- ComboBox Aplicação do Veículo -->
                        <VBox spacing="6.0">
                           <children>
                              <Label styleClass="form-label" text="Aplicação do Veículo" />
                              <ComboBox fx:id="cbAplicacao" maxWidth="1.7976931348623157E308" onAction="#mudarAplicacao" promptText="Seleccione a aplicação..." />
                           </children>
                        </VBox>

                        <VBox spacing="6.0">
                           <children>
                              <Label styleClass="form-label" text="Matrícula (AAA-000-XX)" />
                              <TextField fx:id="txtMatricula" promptText="Ex.: ABC-123-MP" />
                           </children>
                        </VBox>

                        <VBox spacing="6.0">
                           <children>
                              <Label fx:id="lblDocumento" styleClass="form-label" text="Nº de Chassi / Documento de ID" />
                              <TextField fx:id="txtDocumento" promptText="Ex.: CH12345678" />
                           </children>
                        </VBox>

                        <!-- GRUPO DINÂMICO 1: MERCADORIA -->
                        <VBox fx:id="boxMercadoria" spacing="10.0">
                           <children>
                              <VBox spacing="6.0">
                                 <children>
                                    <Label styleClass="form-label" text="Carga Máxima Suportada (toneladas)" />
                                    <TextField fx:id="txtCapacidadeCarga" promptText="Ex.: 20" />
                                 </children>
                              </VBox>
                              <VBox spacing="6.0">
                                 <children>
                                    <Label styleClass="form-label" text="Tipo de Mercadoria Principal" />
                                    <TextField fx:id="txtTipoMercadoria" promptText="Ex.: Carga Geral, Areia, Cimento" />
                                 </children>
                              </VBox>
                           </children>
                        </VBox>

                        <!-- GRUPO DINÂMICO 2: PASSAGEIROS -->
                        <VBox fx:id="boxPassageiros" managed="false" spacing="10.0" visible="false">
                           <children>
                              <VBox spacing="6.0">
                                 <children>
                                    <Label styleClass="form-label" text="Total de Passageiros (Lotação Máxima)" />
                                    <TextField fx:id="txtPassageiros" promptText="Ex.: 15" />
                                 </children>
                              </VBox>
                              <VBox spacing="6.0">
                                 <children>
                                    <Label styleClass="form-label" text="Tipo de Carroceria / Veículo" />
                                    <TextField fx:id="txtTipoCarroceria" promptText="Ex.: Minibus, Van, Autocarro" />
                                 </children>
                              </VBox>
                           </children>
                        </VBox>

                        <VBox spacing="6.0">
                           <children>
                              <Label styleClass="form-label" text="Proprietário" />
                              <ComboBox fx:id="cbProprietario" maxWidth="1.7976931348623157E308" promptText="Seleccione o proprietário" />
                           </children>
                        </VBox>

                        <Label fx:id="lblMensagem" styleClass="mensagem-erro" wrapText="true" />

                        <Pane VBox.vgrow="ALWAYS" />

                        <!-- Ações -->
                        <VBox spacing="10.0">
                           <children>
                              <HBox spacing="10.0">
                                 <children>
                                    <Button fx:id="btnGuardar" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#guardar" styleClass="btn-primario" text="Guardar" HBox.hgrow="ALWAYS" />
                                    <Button fx:id="btnActualizar" disable="true" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#actualizar" styleClass="btn-secundario" text="Actualizar" HBox.hgrow="ALWAYS" />
                                 </children>
                              </HBox>
                              <HBox spacing="10.0">
                                 <children>
                                    <Button fx:id="btnLimpar" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#limpar" styleClass="btn-secundario" text="Limpar" HBox.hgrow="ALWAYS" />
                                    <Button fx:id="btnEliminar" disable="true" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#eliminar" styleClass="btn-perigo" text="Eliminar" HBox.hgrow="ALWAYS" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                     </children>
                  </VBox>
               </content>
            </ScrollPane>
         </children>
      </HBox>
   </children>
</VBox>
