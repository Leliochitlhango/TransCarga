<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16.0" styleClass="tela" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.VeiculoViewController">
   <padding>
      <Insets bottom="20.0" left="24.0" right="24.0" top="20.0" />
   </padding>
   <children>
      <Label styleClass="titulo-tela" text="Veículos da frota" />
      <VBox spacing="12.0" styleClass="cartao">
         <padding>
            <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
         </padding>
         <children>
            <GridPane hgap="14.0" vgap="10.0">
               <columnConstraints>
                  <ColumnConstraints minWidth="110.0" />
                  <ColumnConstraints hgrow="ALWAYS" />
                  <ColumnConstraints minWidth="110.0" />
                  <ColumnConstraints hgrow="ALWAYS" />
               </columnConstraints>
               <children>
                  <Label text="Tipo" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                  <ComboBox fx:id="cbTipo" maxWidth="1.7976931348623157E308" promptText="Camião ou Carrinha de carga" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                  <Label text="Proprietário" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                  <ComboBox fx:id="cbProprietario" maxWidth="1.7976931348623157E308" promptText="Seleccione o proprietário" GridPane.columnIndex="3" GridPane.rowIndex="0" />
                  <Label text="Matrícula" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                  <TextField fx:id="txtMatricula" promptText="Ex.: AAA-123-MC" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  <Label text="Capacidade (ton)" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                  <TextField fx:id="txtCapacidade" promptText="Ex.: 2.5" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                  <Label text="Marca" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                  <TextField fx:id="txtMarca" promptText="Ex.: Isuzu" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                  <Label text="Modelo" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                  <TextField fx:id="txtModelo" promptText="Ex.: NPR 75" GridPane.columnIndex="3" GridPane.rowIndex="2" />
               </children>
               <rowConstraints>
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
               </rowConstraints>
            </GridPane>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#guardar" styleClass="btn-primario" text="Guardar novo" />
                  <Button fx:id="btnActualizar" disable="true" mnemonicParsing="false" onAction="#actualizar" styleClass="btn-secundario" text="Actualizar seleccionado" />
                  <Button fx:id="btnLimpar" mnemonicParsing="false" onAction="#limpar" styleClass="btn-neutro" text="Limpar" />
                  <Label fx:id="lblMensagem" styleClass="mensagem" />
               </children>
            </HBox>
         </children>
      </VBox>
      <TableView fx:id="tabela" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="colTipo" prefWidth="120.0" text="Tipo" />
            <TableColumn fx:id="colMatricula" prefWidth="130.0" text="Matrícula" />
            <TableColumn fx:id="colMarca" prefWidth="130.0" text="Marca" />
            <TableColumn fx:id="colModelo" prefWidth="130.0" text="Modelo" />
            <TableColumn fx:id="colCapacidade" prefWidth="120.0" text="Capacidade (ton)" />
            <TableColumn fx:id="colProprietario" prefWidth="220.0" text="Proprietário" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </children>
</VBox>
