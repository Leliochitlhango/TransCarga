<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0" styleClass="conteudo" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.VeiculoViewController">
   <children>
      <!-- Cabeçalho da Página -->
      <VBox spacing="4.0">
         <children>
            <Label styleClass="titulo-pagina" text="Veículos" />
            <Label styleClass="subtitulo-pagina" text="Camiões e carrinhas de carga da frota" />
         </children>
      </VBox>

      <!-- Barra de Filtros Segmentados -->
      <HBox alignment="CENTER_LEFT" spacing="12.0">
         <children>
            <HBox spacing="4.0" styleClass="segmentos">
               <children>
                  <Button mnemonicParsing="false" styleClass="segmento" text="Todos" />
                  <Button mnemonicParsing="false" styleClass="segmento" style="-fx-font-weight: bold; -fx-background-color: #008A4A; -fx-text-fill: white;" text="Camiões" />
                  <Button mnemonicParsing="false" styleClass="segmento" text="Carrinhas" />
               </children>
            </HBox>
            <Pane HBox.hgrow="ALWAYS" />
            <Label styleClass="texto-suave, texto-pequeno" text="Ordenado por capacidade ▲ crescente" />
         </children>
      </HBox>

      <!-- Layout de Duas Colunas (Tabela à esquerda, Formulário à direita) -->
      <HBox spacing="18.0" VBox.vgrow="ALWAYS">
         <children>
            <!-- COLUNA ESQUERDA: LISTA DA FROTA -->
            <VBox spacing="14.0" styleClass="card" HBox.hgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER_LEFT">
                     <children>
                        <Label styleClass="card-titulo" text="Frota" />
                        <Pane HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#limpar" styleClass="btn-primario" text="+ Novo" />
                     </children>
                  </HBox>

                  <TableView fx:id="tabela" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="colMatricula" prefWidth="120.0" text="Matrícula" />
                        <TableColumn fx:id="colTipo" prefWidth="100.0" text="Tipo" />
                        <TableColumn fx:id="colMarca" prefWidth="140.0" text="Marca / Doc. ID" />
                        <TableColumn fx:id="colModelo" prefWidth="130.0" text="Modelo / Mercadoria" />
                        <TableColumn fx:id="colCapacidade" prefWidth="130.0" text="Capacidade ▲" />
                        <TableColumn fx:id="colProprietario" prefWidth="180.0" text="Proprietário" />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>

                  <!-- Paginação -->
                  <HBox alignment="CENTER_LEFT" spacing="12.0">
                     <children>
                        <Label styleClass="texto-suave, texto-pequeno" text="Mostrar 10 · Total 24" />
                        <Pane HBox.hgrow="ALWAYS" />
                        <HBox spacing="6.0">
                           <children>
                              <Button styleClass="btn-primario" style="-fx-min-width: 32px; -fx-min-height: 32px; -fx-padding: 0;" text="1" />
                              <Button styleClass="btn-secundario" style="-fx-min-width: 32px; -fx-min-height: 32px; -fx-padding: 0;" text="2" />
                              <Button styleClass="btn-secundario" style="-fx-min-width: 32px; -fx-min-height: 32px; -fx-padding: 0;" text="3" />
                           </children>
                        </HBox>
                     </children>
                  </HBox>
               </children>
            </VBox>

            <!-- COLUNA DIREITA: FORMULÁRIO DADOS DO VEÍCULO -->
            <VBox maxWidth="420.0" minWidth="340.0" prefWidth="380.0" spacing="16.0" styleClass="card">
               <children>
                  <Label styleClass="card-titulo" text="Dados do veículo" />

                  <!-- Tipo de Veículo -->
                  <VBox spacing="6.0">
                     <children>
                        <Label styleClass="form-label" text="Tipo de Veículo" />
                        <ComboBox fx:id="cbTipo" maxWidth="1.7976931348623157E308" onAction="#mudarTipoVeiculo" promptText="Seleccione Camião ou Carrinha" />
                     </children>
                  </VBox>

                  <VBox spacing="6.0">
                     <children>
                        <Label styleClass="form-label" text="Matrícula" />
                        <TextField fx:id="txtMatricula" promptText="Ex.: DEF-789-MP" />
                     </children>
                  </VBox>

                  <VBox spacing="6.0">
                     <children>
                        <Label fx:id="lblMarca" styleClass="form-label" text="Marca / Doc. Identificação" />
                        <TextField fx:id="txtMarca" promptText="Ex.: Volvo FH ou DI-0023" />
                     </children>
                  </VBox>

                  <VBox spacing="6.0">
                     <children>
                        <Label fx:id="lblModelo" styleClass="form-label" text="Modelo / Mercadoria / Passageiros" />
                        <TextField fx:id="txtModelo" promptText="Ex.: Carga Geral / Areia" />
                     </children>
                  </VBox>

                  <VBox spacing="6.0">
                     <children>
                        <Label styleClass="form-label" text="Capacidade de carga (toneladas)" />
                        <TextField fx:id="txtCapacidade" promptText="Ex.: 20" />
                     </children>
                  </VBox>

                  <VBox spacing="6.0">
                     <children>
                        <Label styleClass="form-label" text="Proprietário" />
                        <ComboBox fx:id="cbProprietario" maxWidth="1.7976931348623157E308" promptText="Seleccione o proprietário" />
                     </children>
                  </VBox>

                  <Label fx:id="lblMensagem" styleClass="mensagem-erro" wrapText="true" />

                  <Pane VBox.vgrow="ALWAYS" />

                  <!-- Ações -->
                  <VBox spacing="10.0">
                     <children>
                        <HBox spacing="10.0">
                           <children>
                              <Button fx:id="btnGuardar" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#guardar" styleClass="btn-primario" text="⤓ Guardar" HBox.hgrow="ALWAYS" />
                              <Button fx:id="btnActualizar" disable="true" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#actualizar" styleClass="btn-secundario" text="Actualizar" HBox.hgrow="ALWAYS" />
                           </children>
                        </HBox>
                        <Button fx:id="btnLimpar" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#limpar" styleClass="btn-secundario" text="Limpar" />
                     </children>
                  </VBox>
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</VBox>
