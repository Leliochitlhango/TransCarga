<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0" styleClass="conteudo" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.TransportesPorProprietarioController">
   <children>
      <!-- Cabeçalho da Página -->
      <VBox spacing="4.0">
         <children>
            <Label styleClass="titulo-pagina" text="Consultas e Serviços Realizados" />
            <Label styleClass="subtitulo-pagina" text="Pesquisa e filtros em tempo real de transportes por veículo e proprietário" />
         </children>
      </VBox>

      <!-- Layout de Duas Colunas -->
      <HBox spacing="18.0" VBox.vgrow="ALWAYS">
         <!-- CARD ESQUERDO: TRANSPORTES POR PROPRIETÁRIO / VEÍCULOS -->
         <VBox spacing="14.0" styleClass="card" HBox.hgrow="ALWAYS">
            <children>
               <Label styleClass="card-titulo" text="Histórico de Viagens e Transportes" />

               <!-- Filtro por Proprietário e Campo de Pesquisa Geral -->
               <HBox spacing="12.0">
                  <children>
                     <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                        <children>
                           <Label styleClass="form-label" text="Filtrar por Proprietário" />
                           <ComboBox fx:id="cbProprietario" maxWidth="1.7976931348623157E308" onAction="#proprietarioSelecionado" promptText="Todos os proprietários" />
                        </children>
                     </VBox>
                     <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                        <children>
                           <Label styleClass="form-label" text="Pesquisa Geral (Veículo, Cliente, Destino...)" />
                           <TextField fx:id="txtPesquisa" promptText="Pesquisar por veículo, cliente, destino..." />
                        </children>
                     </VBox>
                  </children>
               </HBox>

               <TableView fx:id="tabela" VBox.vgrow="ALWAYS">
                  <columns>
                     <TableColumn fx:id="colData" prefWidth="100.0" text="Data" />
                     <TableColumn fx:id="colVeiculo" prefWidth="120.0" text="Veículo" />
                     <TableColumn fx:id="colCliente" prefWidth="140.0" text="Cliente" />
                     <TableColumn fx:id="colOrigem" prefWidth="110.0" text="Origem" />
                     <TableColumn fx:id="colDestino" prefWidth="110.0" text="Destino" />
                     <TableColumn fx:id="colQuantidade" prefWidth="80.0" text="Qtd/Pass." />
                     <TableColumn fx:id="colValor" prefWidth="105.0" text="Valor (MZN)" />
                  </columns>
                  <columnResizePolicy>
                     <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                  </columnResizePolicy>
               </TableView>

               <!-- Rodapé com Badge de Serviços e Subtotal -->
               <HBox alignment="CENTER_LEFT" spacing="12.0">
                  <children>
                     <Label fx:id="lblNumServicos" styleClass="pilula, pilula-verde" text="0 serviços" />
                     <Label fx:id="lblTotal" styleClass="subtotal-destaque" text="Subtotal: 0,00 MZN" />
                     <Pane HBox.hgrow="ALWAYS" />
                     <Label fx:id="lblMensagem" styleClass="texto-suave, texto-pequeno" />
                  </children>
               </HBox>
            </children>
         </VBox>

         <!-- CARD DIREITO: TOTAL POR VEÍCULO -->
         <VBox maxWidth="440.0" minWidth="340.0" prefWidth="380.0" spacing="16.0" styleClass="card">
            <children>
               <Label styleClass="card-titulo" text="Consulta por Veículo" />

               <VBox spacing="6.0">
                  <children>
                     <Label styleClass="form-label" text="Seleccionar Veículo (Camião / Carrinha)" />
                     <ComboBox fx:id="cbVeiculoConsulta" maxWidth="1.7976931348623157E308" onAction="#veiculoSelecionado" promptText="Seleccione a matrícula..." />
                  </children>
               </VBox>

               <!-- Destaque de Valor Arrecadado -->
               <VBox spacing="4.0" styleClass="caixa-destaque-fundo">
                  <children>
                     <Label fx:id="lblTotalVeiculoValor" styleClass="kpi-valor" text="0,00 MZN" />
                     <Label fx:id="lblTotalVeiculoServicos" styleClass="texto-suave" text="0 serviços realizados" />
                  </children>
               </VBox>

               <!-- Mini Gráfico de Barras por Meses -->
               <BarChart fx:id="graficoVeiculo" legendVisible="false" prefHeight="220.0" VBox.vgrow="ALWAYS">
                  <xAxis>
                     <CategoryAxis side="BOTTOM" />
                  </xAxis>
                  <yAxis>
                     <NumberAxis side="LEFT" />
                  </yAxis>
               </BarChart>
            </children>
         </VBox>
      </HBox>
   </children>
</VBox>
