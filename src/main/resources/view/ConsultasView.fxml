<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0" styleClass="conteudo" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.TransportesPorProprietarioController">
   <children>
      <!-- Cabeçalho da Página -->
      <VBox spacing="4.0">
         <children>
            <Label styleClass="titulo-pagina" text="Consultas" />
            <Label styleClass="subtitulo-pagina" text="Serviços por proprietário e total por veículo" />
         </children>
      </VBox>

      <!-- Layout de Duas Colunas conforme Página 8 do PDF -->
      <HBox spacing="18.0" VBox.vgrow="ALWAYS">
         <!-- CARD ESQUERDO: TRANSPORTES POR PROPRIETÁRIO -->
         <VBox spacing="14.0" styleClass="card" HBox.hgrow="ALWAYS">
            <children>
               <Label styleClass="card-titulo" text="Transportes por proprietário" />

               <VBox spacing="6.0">
                  <children>
                     <Label styleClass="form-label" text="Proprietário" />
                     <ComboBox fx:id="cbProprietario" maxWidth="1.7976931348623157E308" promptText="Seleccione o proprietário" />
                  </children>
               </VBox>

               <TableView fx:id="tabela" VBox.vgrow="ALWAYS">
                  <columns>
                     <TableColumn fx:id="colData" prefWidth="100.0" text="Data" />
                     <TableColumn fx:id="colVeiculo" prefWidth="120.0" text="Veículo" />
                     <TableColumn fx:id="colCliente" prefWidth="150.0" text="Cliente" />
                     <TableColumn fx:id="colDestino" prefWidth="130.0" text="Destino" />
                     <TableColumn fx:id="colValor" prefWidth="110.0" text="Valor (MZN)" />
                     <!-- Colunas de compatibilidade invisíveis ou disponíveis -->
                     <TableColumn fx:id="colQuantidade" prefWidth="0.0" text="Qtd" visible="false" />
                     <TableColumn fx:id="colOrigem" prefWidth="0.0" text="Origem" visible="false" />
                  </columns>
                  <columnResizePolicy>
                     <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                  </columnResizePolicy>
               </TableView>

               <!-- Rodapé com Badge de Serviços e Subtotal -->
               <HBox alignment="CENTER_LEFT" spacing="12.0">
                  <children>
                     <Label fx:id="lblNumServicos" styleClass="pilula, pilula-verde" text="2 serviços" />
                     <Label fx:id="lblTotal" style="-fx-font-weight: bold; -fx-font-size: 15px;" text="Subtotal: 117 000 MZN" />
                     <Label fx:id="lblMensagem" styleClass="mensagem-erro" />
                  </children>
               </HBox>
            </children>
         </VBox>

         <!-- CARD DIREITO: TOTAL POR VEÍCULO -->
         <VBox maxWidth="440.0" minWidth="340.0" prefWidth="380.0" spacing="16.0" styleClass="card">
            <children>
               <Label styleClass="card-titulo" text="Total por veículo" />

               <VBox spacing="6.0">
                  <children>
                     <Label styleClass="form-label" text="Veículo" />
                     <ComboBox maxWidth="1.7976931348623157E308" promptText="Seleccione o veículo" />
                  </children>
               </VBox>

               <!-- Destaque de Valor Arrecadado -->
               <VBox spacing="2.0">
                  <children>
                     <Label styleClass="kpi-valor" text="520 000 MZN" />
                     <Label styleClass="texto-suave" text="14 serviços realizados" />
                  </children>
               </VBox>

               <!-- Mini Gráfico de Barras por Meses -->
               <BarChart legendVisible="false" prefHeight="220.0" VBox.vgrow="ALWAYS">
                  <xAxis>
                     <CategoryAxis side="BOTTOM" />
                  </xAxis>
                  <yAxis>
                     <NumberAxis side="LEFT" />
                  </yAxis>
               </BarChart>
            </children>
         </VBox>
      </HBox>
   </children>
</VBox>
