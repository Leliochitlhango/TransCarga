<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0" styleClass="conteudo" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.CarregamentoViewController">
   <children>
      <!-- Cabeçalho da Página -->
      <VBox spacing="4.0">
         <children>
            <Label styleClass="titulo-pagina" text="Novo carregamento / serviço" />
            <Label styleClass="subtitulo-pagina" text="Validação em tempo real de carga e lotação · Data automática do sistema" />
         </children>
      </VBox>

      <!-- Indicador de Passos / Wizard -->
      <HBox spacing="12.0">
         <children>
            <Label alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="passo, passo-activo" text="1 · Cliente e veículo" HBox.hgrow="ALWAYS" />
            <Label alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="passo" text="2 · Carga ou Passageiros" HBox.hgrow="ALWAYS" />
            <Label alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="passo" text="3 · Rota" HBox.hgrow="ALWAYS" />
            <Label alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="passo" text="4 · Confirmar" HBox.hgrow="ALWAYS" />
         </children>
      </HBox>

      <!-- Layout Duas Colunas (Campos do Formulário + Validador Visual) -->
      <HBox spacing="18.0" VBox.vgrow="ALWAYS">
         <children>
            <!-- COLUNA ESQUERDA: CAMPOS DO SERVIÇO -->
            <VBox spacing="16.0" styleClass="card" HBox.hgrow="ALWAYS">
               <children>
                  <GridPane hgap="16.0" vgap="14.0">
                     <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" percentWidth="50.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" percentWidth="50.0" />
                     </columnConstraints>
                     <rowConstraints>
                        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                     </rowConstraints>
                     <children>
                        <!-- Linha 1: Cliente e Veículo -->
                        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                           <children>
                              <Label styleClass="form-label" text="Cliente" />
                              <ComboBox fx:id="cbCliente" maxWidth="1.7976931348623157E308" promptText="Seleccione o cliente" />
                           </children>
                        </VBox>
                        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                           <children>
                              <Label styleClass="form-label" text="Veículo" />
                              <ComboBox fx:id="cbVeiculo" maxWidth="1.7976931348623157E308" onAction="#veiculoSelecionado" promptText="Seleccione o veículo" />
                           </children>
                        </VBox>

                        <!-- Linha 2: Proprietário e Mercadoria / Detalhes -->
                        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                           <children>
                              <Label styleClass="form-label" text="Proprietário (automático)" />
                              <TextField fx:id="txtProprietario" editable="false" focusTraversable="false" promptText="Preenchido automaticamente" />
                           </children>
                        </VBox>
                        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                           <children>
                              <Label fx:id="lblTipoVeiculo" styleClass="form-label" text="Mercadoria / Descrição do Serviço" />
                              <TextField fx:id="txtTipoVeiculo" promptText="Ex.: Sacos de milho / Viagem de Passageiros" />
                           </children>
                        </VBox>

                        <!-- Linha 3: Quantidade (Carga / Passageiros) e Valor (Data removida do formulário) -->
                        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="2">
                           <children>
                              <Label fx:id="lblQuantidade" styleClass="form-label" text="Quantidade (toneladas / passageiros)" />
                              <TextField fx:id="txtQuantidade" promptText="Ex.: 12" />
                           </children>
                        </VBox>
                        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                           <children>
                              <Label styleClass="form-label" text="Valor cobrado (MZN)" />
                              <TextField fx:id="txtValor" promptText="Ex.: 45000" />
                           </children>
                        </VBox>

                        <!-- Linha 4: Origem e Destino -->
                        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="3">
                           <children>
                              <Label styleClass="form-label" text="Origem" />
                              <TextField fx:id="txtOrigem" promptText="Ex.: Maputo" />
                           </children>
                        </VBox>
                        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="3">
                           <children>
                              <Label styleClass="form-label" text="Destino" />
                              <TextField fx:id="txtDestino" promptText="Ex.: Beira" />
                           </children>
                        </VBox>
                     </children>
                  </GridPane>

                  <Label fx:id="lblValidacao" styleClass="mensagem-erro" wrapText="true" />
               </children>
            </VBox>

            <!-- COLUNA DIREITA: VALIDAÇÃO DE CAPACIDADE E LOTAÇÃO -->
            <VBox alignment="CENTER" maxWidth="380.0" minWidth="300.0" prefWidth="340.0" spacing="18.0" styleClass="card">
               <padding>
                  <Insets bottom="24.0" left="20.0" right="20.0" top="20.0" />
               </padding>
               <children>
                  <Label styleClass="card-titulo" text="Validação de capacidade" />

                  <!-- Anel de Progresso Circular -->
                  <StackPane prefHeight="150.0" prefWidth="150.0">
                     <children>
                        <ProgressIndicator fx:id="piCapacidade" prefHeight="130.0" prefWidth="130.0" progress="0.0" styleClass="capacidade-ok" />
                        <VBox alignment="CENTER" spacing="2.0">
                           <children>
                              <Label fx:id="lblCapacidade" styleClass="kpi-valor, lbl-capacidade-grande" text="0" />
                              <Label fx:id="lblRotuloCapacidade" styleClass="texto-suave, texto-pequeno" text="Capacidade máx." />
                           </children>
                        </VBox>
                     </children>
                  </StackPane>

                  <Label fx:id="lblStatusCapacidade" styleClass="pilula, pilula-verde" text="Aguardando dados" />
                  
                  <Label alignment="CENTER" styleClass="texto-suave, texto-pequeno" text="Acima do limite, o anel fica vermelho e o botão Registar é bloqueado." textAlignment="CENTER" wrapText="true" />

                  <Pane VBox.vgrow="ALWAYS" />

                  <!-- Botões de Ação -->
                  <VBox maxWidth="1.7976931348623157E308" spacing="10.0">
                     <children>
                        <Button fx:id="btnRegistar" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#registar" styleClass="btn-primario" text="Registar" />
                        <Button fx:id="btnLimpar" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#limpar" styleClass="btn-secundario" text="Limpar" />
                     </children>
                  </VBox>
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</VBox>
