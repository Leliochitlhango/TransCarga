<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16.0" styleClass="tela" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.TotalPorVeiculoViewController">
   <padding>
      <Insets bottom="20.0" left="24.0" right="24.0" top="20.0" />
   </padding>
   <children>
      <Label styleClass="titulo-tela" text="Total arrecadado por veículo" />
      <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="cartao">
         <padding>
            <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
         </padding>
         <children>
            <Label text="Veículo" />
            <ComboBox fx:id="cbVeiculo" prefWidth="320.0" promptText="Seleccione o veículo" />
            <Button fx:id="btnConsultar" mnemonicParsing="false" onAction="#consultar" styleClass="btn-primario" text="Consultar" />
            <Label fx:id="lblMensagem" styleClass="mensagem" />
         </children>
      </HBox>
      <HBox spacing="16.0">
         <children>
            <VBox spacing="4.0" styleClass="indicador" HBox.hgrow="ALWAYS">
               <padding>
                  <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
               </padding>
               <children>
                  <Label styleClass="indicador-rotulo" text="Serviços realizados" />
                  <Label fx:id="lblNumServicos" styleClass="indicador-valor" text="0" />
               </children>
            </VBox>
            <VBox spacing="4.0" styleClass="indicador" HBox.hgrow="ALWAYS">
               <padding>
                  <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
               </padding>
               <children>
                  <Label styleClass="indicador-rotulo" text="Total arrecadado" />
                  <Label fx:id="lblTotal" styleClass="indicador-valor" text="0,00 MZN" />
               </children>
            </VBox>
         </children>
      </HBox>
      <TableView fx:id="tabela" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="colData" prefWidth="95.0" text="Data" />
            <TableColumn fx:id="colCliente" prefWidth="160.0" text="Cliente" />
            <TableColumn fx:id="colQuantidade" prefWidth="90.0" text="Qtd. (ton)" />
            <TableColumn fx:id="colOrigem" prefWidth="120.0" text="Origem" />
            <TableColumn fx:id="colDestino" prefWidth="120.0" text="Destino" />
            <TableColumn fx:id="colValor" prefWidth="110.0" text="Valor (MZN)" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </children>
</VBox>
