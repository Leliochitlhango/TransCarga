<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16.0" styleClass="tela" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ListaCarregamentosViewController">
   <padding>
      <Insets bottom="20.0" left="24.0" right="24.0" top="20.0" />
   </padding>
   <children>
      <Label styleClass="titulo-tela" text="Carregamentos / transportes realizados" />
      <TableView fx:id="tabela" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="colData" prefWidth="95.0" text="Data" />
            <TableColumn fx:id="colCliente" prefWidth="150.0" text="Cliente" />
            <TableColumn fx:id="colVeiculo" prefWidth="110.0" text="Veículo" />
            <TableColumn fx:id="colProprietario" prefWidth="150.0" text="Proprietário" />
            <TableColumn fx:id="colQuantidade" prefWidth="90.0" text="Qtd. (ton)" />
            <TableColumn fx:id="colOrigem" prefWidth="110.0" text="Origem" />
            <TableColumn fx:id="colDestino" prefWidth="110.0" text="Destino" />
            <TableColumn fx:id="colValor" prefWidth="110.0" text="Valor (MZN)" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <HBox alignment="CENTER_RIGHT" spacing="24.0">
         <children>
            <Label fx:id="lblNumServicos" styleClass="rodape-total" text="Serviços: 0" />
            <Label fx:id="lblTotalGeral" styleClass="rodape-total" text="Total arrecadado: 0,00 MZN" />
         </children>
      </HBox>
   </children>
</VBox>
