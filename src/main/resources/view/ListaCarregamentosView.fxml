<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0" styleClass="conteudo" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ListaCarregamentosViewController">
   <children>
      <!-- Cabeçalho da Página -->
      <VBox spacing="4.0">
         <children>
            <Label styleClass="titulo-pagina" text="Carregamentos realizados" />
            <Label styleClass="subtitulo-pagina" text="Histórico de serviços" />
         </children>
      </VBox>

      <!-- Card Superior de Filtros -->
      <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="card">
         <children>
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="form-label" text="Proprietário" />
                  <ComboBox maxWidth="1.7976931348623157E308" promptText="Todos os proprietários" />
               </children>
            </VBox>
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="form-label" text="Veículo" />
                  <ComboBox maxWidth="1.7976931348623157E308" promptText="Todos os veículos" />
               </children>
            </VBox>
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="form-label" text="De" />
                  <DatePicker maxWidth="1.7976931348623157E308" promptText="01-11-2026" />
               </children>
            </VBox>
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="form-label" text="Até" />
                  <DatePicker maxWidth="1.7976931348623157E308" promptText="17-11-2026" />
               </children>
            </VBox>
            <VBox alignment="BOTTOM_CENTER">
               <children>
                  <Button mnemonicParsing="false" styleClass="btn-secundario" text="Filtrar" />
               </children>
            </VBox>
         </children>
      </HBox>

      <!-- Card Central com Tabela de Carregamentos Realizados -->
      <VBox spacing="14.0" styleClass="card" VBox.vgrow="ALWAYS">
         <children>
            <TableView fx:id="tabela" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colData" prefWidth="105.0" text="Data" />
                  <TableColumn fx:id="colCliente" prefWidth="160.0" text="Cliente" />
                  <TableColumn fx:id="colVeiculo" prefWidth="120.0" text="Veículo" />
                  <TableColumn fx:id="colProprietario" prefWidth="160.0" text="Proprietário" />
                  <TableColumn fx:id="colQuantidade" prefWidth="100.0" text="Qtd. (ton)" />
                  <TableColumn fx:id="colOrigem" prefWidth="120.0" text="Origem" />
                  <TableColumn fx:id="colDestino" prefWidth="120.0" text="Destino" />
                  <TableColumn fx:id="colValor" prefWidth="120.0" text="Valor (MZN)" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>

            <!-- Rodapé com Paginação e Totais -->
            <HBox alignment="CENTER_LEFT" spacing="18.0">
               <children>
                  <Label styleClass="texto-suave, texto-pequeno" text="Mostrar 10 · Total 24" />
                  <HBox spacing="6.0">
                     <children>
                        <Button styleClass="btn-primario" style="-fx-min-width: 32px; -fx-min-height: 32px; -fx-padding: 0;" text="1" />
                        <Button styleClass="btn-secundario" style="-fx-min-width: 32px; -fx-min-height: 32px; -fx-padding: 0;" text="2" />
                        <Button styleClass="btn-secundario" style="-fx-min-width: 32px; -fx-min-height: 32px; -fx-padding: 0;" text="3" />
                     </children>
                  </HBox>
                  <Pane HBox.hgrow="ALWAYS" />
                  <Label fx:id="lblNumServicos" styleClass="card-destaque-titulo" text="Serviços: 0" />
                  <Label fx:id="lblTotalGeral" styleClass="card-destaque-titulo" text="Total: 0,00 MZN" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</VBox>
