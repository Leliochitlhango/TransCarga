<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0" styleClass="conteudo" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ListaCarregamentosViewController">
   <children>
      <!-- Cabeçalho da Página -->
      <VBox spacing="4.0">
         <children>
            <Label styleClass="titulo-pagina" text="Relatórios: Carregamentos Realizados" />
            <Label styleClass="subtitulo-pagina" text="Histórico geral de serviços prestados · Exportação oficial em CSV e PDF" />
         </children>
      </VBox>

      <!-- Card Superior de Filtros e Exportação -->
      <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="card">
         <children>
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="form-label" text="Pesquisar nos Relatórios" />
                  <TextField fx:id="txtPesquisa" promptText="Pesquisar por matrícula, cliente, destino..." />
               </children>
            </VBox>
            <VBox spacing="4.0">
               <children>
                  <Label styleClass="form-label" text="Proprietário" />
                  <ComboBox fx:id="cbProprietario" onAction="#filtrar" prefWidth="200.0" promptText="Todos" />
               </children>
            </VBox>
            <VBox spacing="4.0">
               <children>
                  <Label styleClass="form-label" text="Veículo" />
                  <ComboBox fx:id="cbVeiculo" onAction="#filtrar" prefWidth="180.0" promptText="Todos" />
               </children>
            </VBox>
            <VBox alignment="BOTTOM_LEFT" spacing="4.0">
               <children>
                  <HBox spacing="8.0">
                     <children>
                        <Button fx:id="btnVerDetalhes" mnemonicParsing="false" onAction="#verDetalhes" styleClass="btn-secundario" text="Ver Detalhes" />
                        <Button fx:id="btnExportar" mnemonicParsing="false" onAction="#exportar" styleClass="btn-primario" text="Exportar (PDF / CSV)" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </HBox>

      <!-- Card Central com Tabela de Carregamentos Realizados -->
      <VBox spacing="14.0" styleClass="card" VBox.vgrow="ALWAYS">
         <children>
            <TableView fx:id="tabela" onMouseClicked="#selecionarLinha" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colData" prefWidth="105.0" text="Data" />
                  <TableColumn fx:id="colCliente" prefWidth="150.0" text="Cliente" />
                  <TableColumn fx:id="colVeiculo" prefWidth="120.0" text="Veículo" />
                  <TableColumn fx:id="colProprietario" prefWidth="160.0" text="Proprietário" />
                  <TableColumn fx:id="colQuantidade" prefWidth="100.0" text="Qtd./Pass." />
                  <TableColumn fx:id="colOrigem" prefWidth="110.0" text="Origem" />
                  <TableColumn fx:id="colDestino" prefWidth="110.0" text="Destino" />
                  <TableColumn fx:id="colValor" prefWidth="120.0" text="Valor (MZN)" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>

            <!-- Rodapé com Paginação e Totais -->
            <HBox alignment="CENTER_LEFT" spacing="18.0">
               <children>
                  <Label styleClass="texto-suave, texto-pequeno" text="Dê duplo clique para ver os detalhes completos" />
                  <Pane HBox.hgrow="ALWAYS" />
                  <Label fx:id="lblNumServicos" styleClass="card-destaque-titulo" text="Serviços: 0" />
                  <Label fx:id="lblTotalGeral" styleClass="card-destaque-titulo" text="Total: 0,00 MZN" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</VBox>
