<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16.0" styleClass="tela" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ListaCarrinhasViewController">
   <padding>
      <Insets bottom="20.0" left="24.0" right="24.0" top="20.0" />
   </padding>
   <children>
      <Label styleClass="titulo-tela" text="Carrinhas de carga — ordem crescente de capacidade de carga" />
      <TableView fx:id="tabela" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="colMatricula" prefWidth="130.0" text="Matrícula" />
            <TableColumn fx:id="colMarca" prefWidth="140.0" text="Marca" />
            <TableColumn fx:id="colModelo" prefWidth="140.0" text="Modelo" />
            <TableColumn fx:id="colCapacidade" prefWidth="140.0" text="Capacidade (ton)" />
            <TableColumn fx:id="colProprietario" prefWidth="240.0" text="Proprietário" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <HBox alignment="CENTER_RIGHT">
         <children>
            <Label fx:id="lblTotal" styleClass="rodape-total" text="Total: 0 carrinhas" />
         </children>
      </HBox>
   </children>
</VBox>
