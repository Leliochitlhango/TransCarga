<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0" styleClass="conteudo" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ListaCarrinhasViewController">
   <children>
      <!-- Cabeçalho da Página -->
      <VBox spacing="4.0">
         <children>
            <Label styleClass="titulo-pagina" text="Carrinhas e Minibus (Passageiros)" />
            <Label styleClass="subtitulo-pagina" text="Listagem por ordem crescente de lotação e capacidade · Filtros e detalhes" />
         </children>
      </VBox>

      <!-- Barra de Pesquisa e Ação -->
      <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="card">
         <padding>
            <Insets bottom="12.0" left="16.0" right="16.0" top="12.0" />
         </padding>
         <children>
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="form-label" text="Filtrar Carrinhas / Minibus" />
                  <TextField fx:id="txtPesquisa" promptText="🔍 Pesquisar por matrícula, carroceria ou proprietário..." />
               </children>
            </VBox>
            <VBox alignment="BOTTOM_LEFT">
               <children>
                  <Button fx:id="btnVerDetalhes" mnemonicParsing="false" onAction="#verDetalhes" styleClass="btn-primario" text="👁 Ver Detalhes" />
               </children>
            </VBox>
         </children>
      </HBox>

      <!-- Card com a Tabela de Carrinhas -->
      <VBox spacing="14.0" styleClass="card" VBox.vgrow="ALWAYS">
         <children>
            <TableView fx:id="tabela" onMouseClicked="#selecionarItem" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colDocIdenticacao" prefWidth="140.0" text="DOC. Identificação" />
                  <TableColumn fx:id="colMatricula" prefWidth="140.0" text="Matrícula" />
                  <TableColumn fx:id="colPassageiros" prefWidth="140.0" text="Lotação (Passageiros)" />
                  <TableColumn fx:id="colCapacidade" prefWidth="150.0" text="Capacidade (ton) ▲" />
                  <TableColumn fx:id="colProprietario" prefWidth="240.0" text="Proprietário" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>

            <!-- Rodapé com Paginação e Total -->
            <HBox alignment="CENTER_LEFT" spacing="14.0">
               <children>
                  <Label styleClass="texto-suave, texto-pequeno" text="Dê duplo clique na linha para ver a ficha completa da carrinha" />
                  <Pane HBox.hgrow="ALWAYS" />
                  <Label fx:id="lblTotal" styleClass="card-destaque-titulo" text="Total: 0 carrinhas" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</VBox>
