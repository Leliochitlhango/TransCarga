<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0" styleClass="conteudo" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ListaCamioesViewController">
   <children>
      <!-- Cabeçalho da Página -->
      <VBox spacing="4.0">
         <children>
            <Label styleClass="titulo-pagina" text="Camiões" />
            <Label styleClass="subtitulo-pagina" text="Listagem por ordem crescente de capacidade de carga" />
         </children>
      </VBox>

      <!-- Card com a Tabela de Camiões -->
      <VBox spacing="14.0" styleClass="card" VBox.vgrow="ALWAYS">
         <children>
            <TableView fx:id="tabela" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colDocIdenticacao" prefWidth="140.0" text="DOC. Identificação" />
                  <TableColumn fx:id="colMatricula" prefWidth="140.0" text="Matrícula" />
                  <TableColumn fx:id="colMercadoria" prefWidth="160.0" text="Tipo Mercadoria" />
                  <TableColumn fx:id="colCapacidade" prefWidth="150.0" text="Capacidade (ton) ▲" />
                  <TableColumn fx:id="colProprietario" prefWidth="240.0" text="Proprietário" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>

            <!-- Rodapé com Paginação e Total -->
            <HBox alignment="CENTER_LEFT" spacing="14.0">
               <children>
                  <Label styleClass="texto-suave, texto-pequeno" text="Mostrar 10 · Frota activa" />
                  <Pane HBox.hgrow="ALWAYS" />
                  <Label fx:id="lblTotal" styleClass="card-destaque-titulo" text="Total: 0 camiões" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</VBox>
